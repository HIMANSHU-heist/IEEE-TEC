rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Feedback forms: any signed-in club member can read the questions,
    // but the public "scan the QR" page also needs to read the form
    // before anyone logs in — so reads are open, writes need an account.
    match /feedbackForms/{formId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Feedback responses: the whole point of the QR flow is that people
    // can submit WITHOUT logging in, so creates are open. Reading the
    // collected responses (to view results) still requires an account.
    match /feedbackResponses/{responseId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Everything else (users, teams, sessions, groups, teamRequests)
    // keeps requiring a signed-in @ternaengg.ac.in account, same as
    // before — just no longer time-boxed to expire.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

